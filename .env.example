# ==============================================================================
# JobFlow-AI Environment Configuration Template
# Copy this file to '.env' and fill in your keys:
#   cp .env.example .env
# ==============================================================================

# --- LLM Provider Settings ---
# Choose your preferred LLM provider: "gemini" (free tier) or "ollama" (100% local)
LLM_PROVIDER=gemini

# Google Gemini API Key (Get a free key at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama Settings (Optional, if using local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Application Settings ---
# Environment: development / production
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Browser Automation Settings ---
# Run browser in visible headed mode (true) or invisible headless mode (false)
BROWSER_HEADLESS=false
BROWSER_SLOW_MO_MS=1000
